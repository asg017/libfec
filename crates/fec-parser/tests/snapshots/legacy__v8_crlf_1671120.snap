row "TEXT" line=2 byte=1051 record=2 fields=["TEXT", "C00401224", "F3XN_001", "", "F3XN", "All contributions on Schedule A with a notation in the form 'Earmark For ST-DI Democratic Nominee Fund' (where ST is a state postal abbreviation and DI is a Congressional District number or the letters 'SEN' to indicate a senate race), are contributions earmarked for the 2020 general election nominee of the Democratic party for that Congressional District (or state).  They are held pursuant to Advisory Opinions 1977-16 and 1982-23 and will be transferred to the eventual nominee's authorized committee within 10 days of the primary election."]
