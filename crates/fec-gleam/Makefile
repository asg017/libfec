# Build the NIF into gleam/priv/ and run the Gleam tests (macOS and Linux).
#
#   make                  release build -> gleam/priv/libfec_nif.so
#   make PROFILE=dev      debug build (cargo's target/debug)
#   make test             build, then `gleam test`
#   make gen              regenerate the typed Gleam modules (see below)
#   make check-gen        fail if the checked-in generated modules are stale (CI)
#   make example          build, then run gleam/examples/summary on FEC=<file.fec>
#
# erlang:load_nif/2 appends ".so" on every Unix (macOS included), so the
# cdylib is copied to libfec_nif.so whatever cargo called it.
#
# Generated Gleam: gleam/src/libfec/cover.gleam, gleam/src/libfec/cover/*,
# gleam/src/libfec/itemization.gleam and gleam/src/libfec/itemization/* are
# written by the `gen` bin (src/bin/gen.rs) from fec-parser's GleamType
# descriptions, formatted with `gleam format --stdin`, and checked in. Each
# starts with "//// Generated by crates/fec-gleam/src/bin/gen.rs. Do not edit.";
# `make gen` deletes files carrying that header that it no longer writes and
# never touches any other file. `make check-gen` renders in memory and compares
# with the files on disk (exit 1 on a differing, missing or stale file), so it
# catches both a Rust change without `make gen` and a hand edit. Both need
# `gleam` on PATH.
#
# The `gen` executable links rustler through fec-parser's `gleam` feature; that
# links on Linux too (see the comment on the fec-parser dependency in
# Cargo.toml).

EXT := $(if $(filter Darwin,$(shell uname)),dylib,so)
PROFILE ?= release
# cargo's output dir for the `dev` profile is `debug`; every other profile uses its own name.
PROFILE_DIR := $(if $(filter dev,$(PROFILE)),debug,$(PROFILE))
# Ask cargo rather than assume ../../target, so CARGO_TARGET_DIR is honoured.
TARGET_DIR := $(shell cargo metadata --format-version 1 --no-deps | jq -r .target_directory)
NIF := $(TARGET_DIR)/$(PROFILE_DIR)/liblibfec_nif.$(EXT)

nif:
	cargo build -p fec-gleam --lib --profile $(PROFILE)
	mkdir -p gleam/priv
	cp $(NIF) gleam/priv/libfec_nif.so

test: nif
	cd gleam && gleam test

# Relative to this directory; made absolute because the example runs from its
# own project directory.
FEC ?= ../fec-py/tests/fixtures/1721696.fec

example: nif
	cd gleam/examples/summary && gleam run -- $(abspath $(FEC))

gen:
	cargo run -p fec-gleam --bin gen

check-gen:
	cargo run -p fec-gleam --bin gen -- --check

clean:
	rm -rf gleam/priv gleam/build gleam/examples/summary/build

.PHONY: nif test example gen check-gen clean
